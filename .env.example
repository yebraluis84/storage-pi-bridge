# Shared secret with the backend (any random 32+ char string)
BRIDGE_TOKEN=replace-with-a-long-random-string

# WebSocket URL of the backend
# For Railway: wss://storage-backend-production-cbfe.up.railway.app/bridge
BACKEND_WS_URL=wss://storage-backend-production-cbfe.up.railway.app/bridge

# Friendly name for this bridge (in case you have multiple)
BRIDGE_ID=facility-main

# Synch LoRa gateway radio (XIAO nRF52840 + Wio-SX1262 on USB).
# Auto-detected via /dev/serial/by-id or /dev/ttyACM0 when unset.
# LORA_SERIAL_PATH=/dev/ttyACM0
# Set to 0 on gateways that have no radio plugged in.
# LORA_ENABLED=1
# Print every serial line to the log.
# LORA_DEBUG=0
